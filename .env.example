BROKER=localhost
PORT=1883
API_BASE_URL=http://<IP_DEL_SERVIDOR>:8000
API_KEY=<API_KEY_DEL_SERVIDOR>

# Kincony a64_prod
A64_HOST=192.168.0.103
A64_PORT=6053
A64_NOISE_KEY=<NOISE_KEY_A64_PROD>
A64_EXPECTED_NAME=produccion

# Kincony tank-mix
TANKMIX_HOST=192.168.0.102
TANKMIX_PORT=6053
TANKMIX_NOISE_KEY=<NOISE_KEY_TANK_MIX>
TANKMIX_EXPECTED_NAME=tank-mix

# Tiempos de actuación (segundos)
T_SUCCION=600
T_MB200=600
T_MBMIX=600
T_FILL_POLL_S=30
T_FILL_MAX_S=3600
T_OZ=300
T_DOSIFICACION=51

# Número de balsas instaladas (válvulas EV_IN/EV_OUT_BAND_XX que se apagan
# al arrancar el servicio y en la parada de emergencia /parar)
N_BALSAS=15

# Supervisión de niveles (telemetría de los nodos)
NIVEL_DATOS_MAX_S=30     # antigüedad máxima de la última lectura de nivel válida (s)
T_SIN_PROGRESO_S=300     # llenado del mix: tiempo máximo sin que el nivel suba (s)
PROGRESO_MIN_L=2         # llenado del mix: subida mínima esperada en ese tiempo (L)
